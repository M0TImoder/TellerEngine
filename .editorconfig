root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{hpp,cpp,h,c}]
indent_size = 4

[cmake/CPM.cmake]
indent_size = unset
trim_trailing_whitespace = false
insert_final_newline = false

[LICENSE*]
indent_size = unset
trim_trailing_whitespace = false
insert_final_newline = false
